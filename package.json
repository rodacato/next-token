{
  "name": "next-token",
  "version": "0.1.0",
  "private": true,
  "description": "Learn how LLMs work, build with them, train them and ship them, in a letterpress print shop where every token is set by hand.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://rodacato.github.io/next-token/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rodacato/next-token.git"
  },
  "bugs": "https://github.com/rodacato/next-token/issues",
  "scripts": {
    "dev": "vite",
    "build": "npm run manifest && tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test --grep @smoke",
    "i18n:check": "node scripts/check-i18n.ts",
    "check": "npm run typecheck && npm run lint && npm run test && npm run i18n:check",
    "boards": "python3 -m http.server 4317",
    "boards:capture": "node design/step-0/capture.mjs",
    "record:runs": "node scripts/record-runs.ts",
    "record:llm": "node scripts/record-llm.ts",
    "manifest": "node scripts/build-manifest.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "playwright": "^1.64.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@fontsource-variable/bodoni-moda": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@huggingface/transformers": "^4.3.1",
    "js-tiktoken": "^1.0.21",
    "motion": "^14.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  }
}
